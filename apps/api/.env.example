# Copy to .env for local development. Never use these placeholders in production.
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public
AUTH_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
OWNER_USERNAME=replace-with-local-owner
OWNER_PASSWORD=replace-with-a-local-password
# Required in production. Generate a unique, high-entropy secret of at least 32 characters; never reuse AUTH_JWT_SECRET.
# Replace this placeholder in local development too if you want to test separate QR encryption keys.
PERMANENT_PASS_QR_ENCRYPTION_KEY=replace-with-a-random-unique-32-plus-character-secret
